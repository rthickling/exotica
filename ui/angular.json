{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "exotica-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "../fixtures/*.json",
                "input": ".",
                "output": "fixtures"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "outputPath": "dist/exotica"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "650kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "none"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "exotica-ui:build:development",
            "port": 4200,
            "host": "127.0.0.1",
            "proxyConfig": "proxy.conf.json"
          },
          "defaultConfiguration": "development",
          "configurations": {
            "development": {
              "buildTarget": "exotica-ui:build:development"
            }
          }
        }
      }
    }
  }
}
